{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clinical-assistant-user-sync-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clinical-assistant-user-data-staging",
      "database_id": "ec476fa1-d463-4697-a5b8-5b3044657d4c",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://tinnxq-alt.github.io,http://localhost:8000,http://127.0.0.1:8000",
    "ALLOWED_GITHUB_USER_IDS": "316177058",
    "GITHUB_CALLBACK_URL": "https://clinical-assistant-user-sync-staging.tinnxq.workers.dev/auth/github/callback"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}

