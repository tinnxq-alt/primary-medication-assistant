{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "primary-medication-smart-search",
  "main": "src/index-v4.js",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://tinnxq-alt.github.io,http://localhost:8000,http://127.0.0.1:8000",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}